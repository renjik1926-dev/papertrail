# Copy to .env (in this folder, or in the data folder shown by `papertrail doctor`).
# Never commit a real key: .env is git-ignored.
ANTHROPIC_API_KEY=
# Only needed if your key isn't scoped to a Console workspace.
ANTHROPIC_WORKSPACE_ID=

# claude | replay | fake
PAPERTRAIL_PROVIDER=claude
PAPERTRAIL_MODEL=claude-haiku-5-5
# low | medium | high
PAPERTRAIL_EFFORT=medium
PAPERTRAIL_MAX_DOCS_PER_DAY=50
# PAPERTRAIL_DATA_DIR=
# PAPERTRAIL_PORT=8000
# PAPERTRAIL_DEV=1   # also accept the Vite dev server's origin (development only)
